{
	"name": "WikibaseLexeme",
	"private": true,
	"config": {
		"snl": {
			"src": "resources/special/new-lexeme",
			"dist": "resources/special/new-lexeme-dist",
			"cjs": "SpecialNewLexeme.cjs.js",
			"css": "new-lexeme-special-page.css"
		}
	},
	"scripts": {
		"api-testing": "run-s api-testing:*",
		"api-testing:e2e": "mocha --timeout 0 tests/api",
		"api-testing:spec": "mocha --timeout 0 tests/api/openapi-validation tests/spec",
		"selenium-test": "npm run cypress:parallel",
		"test": "run-s test:*",
		"spec:fragment": "run-s spec:fragment:generate spec:fragment:bundle",
		"spec:fragment:generate": "node src/MediaWiki/RestApi/specs/index.fragment.js > src/MediaWiki/RestApi/specs/openapi.fragment.generated.json",
		"spec:fragment:bundle": "redocly bundle src/MediaWiki/RestApi/specs/openapi.fragment.generated.json --dereferenced --remove-unused-components -o src/MediaWiki/RestApi/specs/openapi.fragment.dereferenced.json",
		"spec:combine": "redocly join --without-x-tag-groups ../Wikibase/repo/rest-api/src/openapi.json src/MediaWiki/RestApi/specs/openapi.fragment.dereferenced.json -o specs/openapi-combined.json",
		"lint:spec-combined": "run-s spec:combine lint:spec-combined:run",
		"lint:spec-combined:run": "redocly lint specs/openapi-combined.json",
		"test:spec-tools": "mocha --timeout 0 tests/spec",
		"test:grunt": "grunt test",
		"test:snl-distnodiff": "run-s snl:install snl:build snl:cp snl:diff",
		"test:snl-main": "git -C $npm_package_config_snl_src branch --contains HEAD main | grep -q .",
		"fix": "grunt fix",
		"bump-special-new-lexeme": "run-s snl:fetch snl:checkout snl:install snl:build snl:cp snl:add snl:restore",
		"snl:fetch": "git -C $npm_package_config_snl_src fetch origin main",
		"snl:checkout": "git -C $npm_package_config_snl_src -c advice.detachedHead=false checkout FETCH_HEAD",
		"snl:install": "npm -C $npm_package_config_snl_src i",
		"snl:build": "npm -C $npm_package_config_snl_src run build",
		"snl:cp": "run-p snl:cp:*",
		"snl:cp:cjs": "cp $npm_package_config_snl_src/dist/$npm_package_config_snl_cjs $npm_package_config_snl_dist/",
		"snl:cp:css": "cp $npm_package_config_snl_src/dist/$npm_package_config_snl_css $npm_package_config_snl_dist/",
		"snl:add": "git add $npm_package_config_snl_src $npm_package_config_snl_dist",
		"snl:restore": "git -C $npm_package_config_snl_src checkout -",
		"snl:dev": "run-s snl:build snl:cp",
		"snl:diff": "git diff --exit-code $npm_package_config_snl_dist",
		"cypress:open": "CYPRESS_CACHE_FOLDER=./cypress/.cache cypress open",
		"cypress:run": "CYPRESS_CACHE_FOLDER=./cypress/.cache cypress run",
		"cypress:parallel": "cypress-parallel -s cypress:run -t 2 -d './cypress/e2e/**/*.cy.ts'"
	},
	"devDependencies": {
		"@redocly/cli": "^1.25.11",
		"@wmde/eslint-config-wikimedia-typescript": "0.2.13",
		"ajv": "^8.17.1",
		"api-testing": "^1.7.3",
		"cypress": "^13.17.0",
		"cypress-parallel": "^0.14.0",
		"cypress-wikibase-api": "^0.0.7",
		"eslint-config-wikimedia": "0.29.1",
		"eslint-plugin-chai-friendly": "^1.2.1",
		"eslint-plugin-cypress": "^3.6.0",
		"eslint-plugin-jsonc": "^2.21.1",
		"eslint-plugin-promise": "^7.3.0",
		"grunt": "1.6.1",
		"grunt-banana-checker": "0.13.0",
		"grunt-eslint": "^24.3.0",
		"grunt-jasmine-nodejs": "^1.6.1",
		"grunt-stylelint": "^0.21.0",
		"jasmine": "^5.5.0",
		"jquery": "3.7.1",
		"jsdom": "^25.0.1",
		"lodash": "^4.17.21",
		"mocha": "^11.7.6",
		"module-alias": "^2.2.3",
		"npm-run-all": "^4.1.5",
		"request": "^2.88.2",
		"sinon": "^19.0.2",
		"stylelint-config-wikimedia": "^0.19.3",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.69.0",
		"unexpected": "^13.2.1",
		"unexpected-dom": "^6.0.1",
		"unexpected-sinon": "^11.1.0",
		"vue": "3.5.13",
		"vuex": "4.0.2"
	}
}
